# copy to apps/api/.env and fill in -- .env is gitignored, never commit it

POSTGRES_PASSWORD=change-me
# signs login tokens -- use a long random value, e.g. the output of: openssl rand -base64 48
JWT_SECRET=

# browser origins allowed to call the API (Electron dev server, and "null" for the packaged file:// app)
CORS_ORIGINS=http://localhost:3000,null

# only for running the API outside docker (npm run dev) -- compose builds its own
DATABASE_URL=postgresql://chessbox:change-me@localhost:5432/chessbox
